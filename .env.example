# Generate real values using: python3 scripts/setup.py
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
POSTGRES_PORT=55473
DATABASE_URL=postgresql://proxy_service:replace-with-a-random-url-safe-password@127.0.0.1:55473/proxy_service
BIND_ADDR=127.0.0.1:8080
APP_PORT=8080
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
PROXY_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes

# Optional: set both to alert when a valid proxy request has no available proxies.
# Requires curl. Best-effort delivery, at most one attempt per user per 60 seconds.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
